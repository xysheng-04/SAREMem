# Copy to config.env, chmod 600, and replace all CHANGE_ME values.
# Relative persistence paths resolve against THIS config file.
AML_SEARCH_PIPELINE=simple
AML_STORAGE_PATH=../state/production/memory.sqlite3
AML_MEMORY_SYSTEM_KEY=CHANGE_ME_LONG_RANDOM_MEMORY_SYSTEM_KEY
AML_LLM_API_KEY=CHANGE_ME
AML_EMBEDDING_API_KEY=CHANGE_ME
AML_LLM_BASE_URL=https://CHANGE_ME/v1
AML_EMBEDDING_BASE_URL=https://CHANGE_ME/v1
AML_BIND_HOST=127.0.0.1
AML_PORT=8000
AML_PUBLIC_BASE_URL=https://CHANGE_ME
# Legacy defaults remain frozen. The API applies the competition top-20 ceiling.
AML_PROD_TOTAL_SECONDS=1680
AML_PROD_SIMPLE_SECONDS=1140
AML_PROD_LEGACY_SECONDS=420
AML_PROD_SEED_RESERVE_SECONDS=90
AML_PROD_CLEANUP_SECONDS=5
AML_PROD_MAX_CONCURRENT_SEARCHES=2
AML_PROD_WORKER_MEMORY_MB=2048
# Application ceiling 28 minutes; preserve 2 minutes below AML 30-minute limit.
AML_PROD_PROVIDER_TIMEOUT_SECONDS=300
AML_PROD_CONNECT_TIMEOUT_SECONDS=30
